{
	"name": "iac-p5",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"deploy:prod": "wrangler deploy --env production",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "wrangler types && tsc --noEmit -p . && tsc --noEmit -p test",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@vitest/coverage-istanbul": "~4.1.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.0",
		"wrangler": "^4"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260918.1": true
	}
}
